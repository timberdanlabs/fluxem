# FluxEM Microservice Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
APP_NAME=FluxEM
ENVIRONMENT=production

# Optimization Settings
DEFAULT_TIMESTEP_MINUTES=30
MAX_HORIZON_HOURS=48

# MQTT Configuration
MQTT_ENABLED=false
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=fluxem

# Drift Watchdog Thresholds (Percentage)
SOLAR_DRIFT_THRESHOLD_PCT=25.0
PRICE_DRIFT_THRESHOLD_PCT=20.0
LOAD_DRIFT_THRESHOLD_PCT=30.0
